{
  "name": "ComplexArrays",
  "namemsg": "ca-name",
  "author": "Xxmarijnw",
  "version": "5.5.5",
  "url": "https://www.mediawiki.org/wiki/Extension:ComplexArrays",
  "descriptionmsg": "ca-description",
  "license-name": "GPL-2.0-or-later",
  "type": "parserhook",
  "requires": {
    "MediaWiki": ">= 1.39.0",
    "platform": {
      "php": ">= 8.1"
    }
  },
  "MessagesDirs": {
    "ComplexArrays": [
      "i18n"
    ]
  },
  "AutoloadNamespaces": {
    "ComplexArrays\\": "src/"
  },
  "ExtensionMessagesFiles": {
    "ComplexArraysMagic": "ComplexArrays.i18n.php"
  },
  "HookHandlers": {
    "main": {
      "class": "ComplexArrays\\Hooks"
    }
  },
  "Hooks": {
    "ParserFirstCallInit": "main",
    "ParserClearState": "main"
  },
  "config": {
    "EnableResultPrinter": {
      "value": false
    },
    "DefinedArraysGlobal": {
      "value": []
    }
  },
  "manifest_version": 2
}
