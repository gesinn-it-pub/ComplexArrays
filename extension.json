{
  "name": "ComplexArrays",
  "namemsg": "ca-name",
  "author": [
    "Marijn van Wezel (Xxmarijnw)",
    "[https://www.gesinn.it gesinn.it GmbH & Co. KG] (Alexander Gesinn)"
  ],
  "version": "5.5.5",
  "url": "https://www.mediawiki.org/wiki/Extension:ComplexArrays",
  "descriptionmsg": "ca-description",
  "license-name": "GPL-2.0-or-later",
  "type": "parserhook",
  "requires": {
    "MediaWiki": ">= 1.39.0",
    "platform": {
      "php": ">= 8.1"
    }
  },
  "MessagesDirs": {
    "ComplexArrays": [
      "i18n"
    ]
  },
  "AutoloadNamespaces": {
    "ComplexArrays\\": "src/"
  },
  "ExtensionMessagesFiles": {
    "ComplexArraysMagic": "ComplexArrays.i18n.php"
  },
  "HookHandlers": {
    "main": {
      "class": "ComplexArrays\\Hooks"
    },
    "smw": {
      "class": "ComplexArrays\\SMW\\Hooks"
    }
  },
  "Hooks": {
    "ParserFirstCallInit": "main",
    "ParserClearState": "main",
    "SMW::Setup::AfterInitializationComplete": "smw"
  },
  "config": {
    "DefinedArraysGlobal": {
      "value": []
    }
  },
  "manifest_version": 2
}
